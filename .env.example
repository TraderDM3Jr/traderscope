# --- TraderScope environment ---
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# On Vercel / your host, set these as platform environment variables instead.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Bearer token the MT4/MT5 bridge must send: Authorization: Bearer <INGEST_SECRET>
# Generate a strong one, e.g. `openssl rand -hex 24`
INGEST_SECRET=change_me_to_a_long_random_secret

# Dashboard login password (the gate users type to unlock the app).
# If unset, the app stays locked. Set the same value in Vercel.
APP_PASSWORD=set_a_strong_dashboard_password

# Optional extra salt for the session cookie (leave default if unsure)
APP_PEPPER=traderscope-static-pepper

# --- Off-board alerts (C) — set what you use; unset = DB-only alerts ---
# Telegram: message @BotFather on Telegram -> /newbot -> copy the token below,
# then start a chat with the bot and put your chat id (use @userinfobot to get it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord (or any Slack-compatible webhook): Server Settings -> Integrations -> Webhook
DISCORD_WEBHOOK_URL=

# Public base URL of the deployed app (used in docs / webhook hints)
NEXT_PUBLIC_APP_URL=https://your-domain.com
